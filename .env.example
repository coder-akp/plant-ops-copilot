# Copy this file to ".env" and fill in the required values. ".env" is git-ignored and must never be committed.
# In Azure, infra/deploy.sh sets the same names as container environment variables and secrets.

# Model used by the live agents
# none   = no live runs (the site only plays recorded runs); safe default
# mock   = scripted stand-in model, no key needed (local development and tests only)
# gemini = Google Gemini API (free tier available)
# azure  = Azure OpenAI / Microsoft Foundry deployment
LLM_PROVIDER=none

# Gemini (LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
# Use a model listed as free tier in Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash

# Azure OpenAI / Foundry (LLM_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Deployment name chosen in Foundry (not necessarily the model name)
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Set to "low" for reasoning models (gpt-5 family); leave empty for gpt-4.1 and gpt-4o
AZURE_REASONING_EFFORT=
# List prices in USD per 1M tokens; used only for the estimate shown in the UI
# PRICE_IN_PER_M=0.25
# PRICE_OUT_PER_M=2.00

# Cost guards for live runs (defaults shown)
# LIVE_ENABLED=true          # false switches live runs off immediately
# DAILY_MAX_RUNS=25          # all visitors combined, per UTC day
# PER_IP_MAX_RUNS=3          # per visitor, per UTC day
# DAILY_BUDGET_USD=0.50      # estimated spend cap per UTC day (irrelevant on the free Gemini tier)
# LIVE_COOLDOWN_S=15         # minimum seconds between live runs
# MAX_RUN_TOKENS=60000       # hard token cap per run
# MAX_OUTPUT_TOKENS=2500     # per model call
# RUN_TIMEOUT_S=120
# ACCESS_CODE=               # if set, live runs require this code (share only with selected people)

# Display
# GITHUB_URL=https://github.com/<github-user>/plant-ops-copilot
